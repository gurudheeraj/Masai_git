8. Number of Returned Books per Borrower
db.loans.aggregate([
  { $match: { status: "Returned" } },
  {
    $group: {
      _id: "$borrowerId",
      returnedBooks: { $sum: 1 }
    }
  }
])

9. Borrowers Who Borrowed Multiple Genres
db.loans.aggregate([
  {
    $lookup: {
      from: "books",
      localField: "bookId",
      foreignField: "_id",
      as: "book"
    }
  },
  { $unwind: "$book" },
  {
    $group: {
      _id: "$borrowerId",
      genres: { $addToSet: "$book.genre" }
    }
  },
  { $match: { "genres.1": { $exists: true } } }
])

10. List Borrowers with Total Borrow Count and Names
db.loans.aggregate([
  {
    $group: {
      _id: "$borrowerId",
      totalBorrowed: { $sum: 1 }
    }
  },
  {
    $lookup: {
      from: "borrowers",
      localField: "_id",
      foreignField: "_id",
      as: "borrower"
    }
  },
  { $unwind: "$borrower" },
  {
    $project: {
      _id: 0,
      borrowerName: "$borrower.name",
      totalBorrowed: 1
    }
  }
])
