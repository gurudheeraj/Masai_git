3. Average Total Price of All Orders
db.orders.aggregate([
  {
    $group: {
      _id: null,
      averageOrderPrice: { $avg: "$totalPrice" }
    }
  }
])

4. Number of Orders Placed Each Month
db.orders.aggregate([
  {
    $addFields: {
      month: { $substr: ["$orderDate", 0, 7] } // YYYY-MM
    }
  },
  {
    $group: {
      _id: "$month",
      totalOrders: { $sum: 1 }
    }
  },
  { $sort: { _id: 1 } }
])

5. Percentage of Cancelled Orders
db.orders.aggregate([
  {
    $group: {
      _id: "$status",
      count: { $sum: 1 }
    }
  },
  {
    $group: {
      _id: null,
      totalOrders: { $sum: "$count" },
      cancelledOrders: {
        $sum: {
          $cond: [{ $eq: ["$_id", "Cancelled"] }, "$count", 0]
        }
      }
    }
  },
  {
    $project: {
      _id: 0,
      cancelledPercentage: {
        $multiply: [
          { $divide: ["$cancelledOrders", "$totalOrders"] },
          100
        ]
      }
    }
  }
])

