5. mentor.controller.js
const Mentor = require("../models/mentor.model");
const Session = require("../models/session.model");

// POST /mentors
exports.createMentor = async (req, res) => {
  try {
    const mentor = await Mentor.create(req.body);
    res.status(201).json(mentor);
  } catch (err) {
    res.status(400).json({ error: err.message });
  }
};

// GET /mentors/:id/sessions
exports.getMentorSessions = async (req, res) => {
  try {
    const sessions = await Session.find({
      mentorId: req.params.id,
      isActive: true,
      isArchived: false
    })
      .sort({ scheduledAt: -1 })
      .limit(5);

    res.json(sessions);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};

// GET /mentors/:id/learners/count
exports.countMentorLearners = async (req, res) => {
  try {
    const sessions = await Session.find({
      mentorId: req.params.id,
      isArchived: false
    }).select("learners");

    const count = sessions.reduce(
      (total, s) =>
        total +
        s.learners.filter(l => l.attendanceStatus === "attended").length,
      0
    );

    res.json({ totalLearners: count });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};

// DELETE /mentors/:id (Soft delete + cascade)
exports.deleteMentor = async (req, res) => {
  try {
    await Mentor.findByIdAndUpdate(req.params.id, { isActive: false });

    await Session.updateMany(
      { mentorId: req.params.id },
      { isActive: false }
    );

    res.json({ message: "Mentor and related sessions deactivated" });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};


