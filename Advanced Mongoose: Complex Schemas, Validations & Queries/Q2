module.exports = (err, req, res, next) => {
  console.log("ERROR:", err.message); // small debug log

  if (err.code === 11000) {
    return res.status(400).json({
      message: "Email already exists"
    });
  }

  res.status(400).json({
    error: err.message || "Something went wrong"
  });
};


