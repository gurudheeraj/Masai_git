1. index.js
// index.js

const express = require("express");
const rateLimit = require("express-rate-limit");

const app = express();
const apiRoutes = require("./routes/api");

// Middleware to parse JSON
app.use(express.json());

// Configure rate limiter (5 requests per minute)
const limitedAccess = rateLimit({
    windowMs: 60 * 1000, // 1 minute
    max: 5, // limit each IP to 5 requests per window
    message: {
        error: "Too many requests, please try again later."
    }
});

// Apply rate limiter ONLY to /api/limited
app.use("/api/limited", limitedAccess);

// Use API routes
app.use("/api", apiRoutes);

// Handle undefined routes (404)
app.use((req, res) => {
    res.status(404).json({
        error: "404 Not Found"
    });
});

// Start server
const PORT = 3000;
app.listen(PORT, () => {
    console.log(`Server running on http://localhost:${PORT}`);
});


2. api.js
// routes/api.js

const express = require("express");
const router = express.Router();

// Public route (No rate limiting)
router.get("/public", (req, res) => {
    res.json({
        message: "This is a public endpoint!"
    });
});

// Limited route (Rate limiter applied from index.js)
router.get("/limited", (req, res) => {
    res.json({
        message: "You have access to this limited endpoint!"
    });
});

module.exports = router;


# run the server
node index.js
